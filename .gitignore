# 构建产物
target/
*.class

# 前端构建产物（由 cd frontend && npm run build 生成，内容随源码变化，不要提交）
src/main/resources/static/

# IDE
.idea/
*.iml
.vscode/
*.ipr
*.iws

# 系统文件
.DS_Store
Thumbs.db

# 密钥与本地配置（切勿提交）
.env
.env.*
application-local.yml
application-secret.yml
*.pem
*.key

# 日志
logs/
*.log

# JVM / IDEA 调试产生的临时文件
.attach_pid*

# 本地测试产物（自己跑接口时留下的临时文件）
response.json
test.md
